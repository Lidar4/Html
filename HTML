<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>আমার ডায়েরি</title>
  <link rel="stylesheet" href="style.css" />
</head>
<body>
  <h1>আমার ডায়েরি</h1>
  <textarea id="diary" placeholder="আজ তুমি কী অনুভব করলে?..."></textarea>
  <br />
  <button onclick="saveDiary()">সংরক্ষণ করো</button>
  <button onclick="clearDiary()">মুছে ফেলো</button>

  <script>
    window.onload = () => {
      document.getElementById('diary').value = localStorage.getItem('myDiary') || '';
    };
    function saveDiary() {
      const text = document.getElementById('diary').value;
      localStorage.setItem('myDiary', text);
      alert("সংরক্ষণ হয়ে গেছে!");
    }
    function clearDiary() {
      if (confirm("তুমি কি নিশ্চিত?")) {
        localStorage.removeItem('myDiary');
        document.getElementById('diary').value = '';
      }
    }
  </script>
</body>
</html>
